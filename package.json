{
  "name": "correos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --names \"api,web\" --prefix-colors \"green,cyan\" --kill-others-on-fail \"pnpm -C server start\" \"pnpm -C client dev\"",
    "install:all": "pnpm -C client install && pnpm -C server install"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
